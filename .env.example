# DM Locker Pro Environment Configuration
PORT=3001

# TinyFish Web Agent API Configuration (https://docs.tinyfish.ai/)
# Leave TINYFISH_API_KEY empty to run offline with transparent development simulation (mock portal mode).
# Add your official API key (sk-tinyfish-...) for live autonomous browser agent execution.
TINYFISH_API_KEY=
TINYFISH_API_URL=https://agent.tinyfish.ai

# Optional Configuration
# TINYFISH_TIMEOUT_MS=120000
# TINYFISH_DEFAULT_INSURANCE_URL=https://en.wikipedia.org/wiki/Insurance_policy
# TINYFISH_FORCE_MOCK=false

# Configurable Frontend Base URL for QR Sharing (Optional)
# - Default: current browser origin (http://localhost:5173 or LAN IP)
# - For Wi-Fi phone testing: http://<your-lan-ip>:5173 (e.g. http://10.1.246.207:5173)
# - For Deployed HTTPS demos: https://app.dmlocker.pro
VITE_FRONTEND_BASE_URL=

# SMTP Email Reminder Integration (Nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional Webhook Secret for Render Cron Job / Uptime Ping
# CRON_SECRET=


