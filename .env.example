# DM Locker Pro Environment Configuration
PORT=3001

# TinyFish Web Agent API Configuration (https://docs.tinyfish.ai/)
# Leave TINYFISH_API_KEY empty to run offline with transparent development simulation (mock portal mode).
# Add your official API key (sk-tinyfish-...) for live autonomous browser agent execution.
TINYFISH_API_KEY=
TINYFISH_API_URL=https://agent.tinyfish.ai

# Optional Configuration
# TINYFISH_TIMEOUT_MS=120000
# TINYFISH_DEFAULT_INSURANCE_URL=https://en.wikipedia.org/wiki/Insurance_policy
# TINYFISH_FORCE_MOCK=false

