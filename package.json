{
  "name": "chatgpt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"node server/index.js\" \"vite --port 5173\"",
    "dev:client": "vite --port 5173",
    "dev:server": "node server/index.js",
    "test": "node server/test-phoenix.js",
    "test:phoenix": "node server/test-phoenix.js",
    "test:legacy": "node server/test-suite.js",
    "test:qr": "node server/test-qr.js",
    "test:reminders": "node server/test-reminders.js",
    "test:features": "node server/test-new-features.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
